+    static void cheapBuildingClassification()throws Exception{
+        G53FreeResponseHarness.Fixture f=R10TemporaryResponseHarness.nearby(1);
+        f.enemy(800,1800,1000,"SURFACE");Map<String,Object> enemy=f.visible.get(0);
