+                    "pathKnown",true,"safeSegmentKnown",true,"x",tx,"y",ty,"waypointX",wx,"waypointY",wy);
+            }return super.readStrategy(path,event);
+        }
+        void moveToLastReceipt(long time,long frame)throws Exception{
